{
    "name": "1815-api",
    "version": "1.0.0",
    "description": "1815 API - Cardano address shortener and blockchain explorer service",
    "main": "dist/index.js",
    "scripts": {
        "prebuild": "rm -rf dist",
        "build": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
        "build:dev": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "format": "prettier --write src/**/*.ts",
        "format:check": "prettier --check src/**/*.ts",
        "docker:build": "docker build -t 1815-api .",
        "docker:build:prod": "docker build -t 1815-api:production --target production .",
        "docker:dev": "docker compose up -d",
        "docker:dev:build": "docker compose up -d --build",
        "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
        "docker:prod:build": "docker compose -f docker-compose.prod.yml up -d --build",
        "docker:down": "docker compose down",
        "docker:down:prod": "docker compose -f docker-compose.prod.yml down",
        "docker:logs": "docker compose logs -f",
        "docker:logs:prod": "docker compose -f docker-compose.prod.yml logs -f",
        "pm2:start": "pm2 start ecosystem.config.js",
        "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
        "pm2:stop": "pm2 stop 1815-api",
        "pm2:restart": "pm2 restart 1815-api",
        "pm2:logs": "pm2 logs 1815-api",
        "pm2:monit": "pm2 monit",
        "deploy:staging": "./scripts/deploy.sh staging",
        "deploy:production": "./scripts/deploy.sh production",
        "health-check": "./scripts/health-check.sh",
        "mongodb:viewer": "node mongodb-viewer.js",
        "mongodb:quick": "node mongodb-quick-view.js",
        "mongodb:check": "node check-mongodb.mjs",
        "mongodb:verify": "node verify-mongodb-express.mjs",
        "mongodb:web": "echo '🌐 Opening MongoDB Web Viewer...' && open http://localhost:3000/api/v1/web-viewer/mongodb"
    },
    "keywords": [
        "cardano",
        "blockchain",
        "api",
        "shortener",
        "explorer",
        "1815"
    ],
    "author": "Emmanuel Odero <emmanuelodero@techmates.team>",
    "license": "MIT",
    "dependencies": {
        "@blockfrost/blockfrost-js": "^6.1.0",
        "@sendgrid/mail": "^8.1.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.19.27",
        "@types/nodemailer": "^6.4.14",
        "@types/qrcode": "^1.5.5",
        "@types/uuid": "^9.0.7",
        "aws-sdk": "^2.1498.0",
        "bcryptjs": "^2.4.3",
        "bull": "^4.12.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "crypto-js": "^4.2.0",
        "dompurify": "^3.3.1",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "fast-check": "^3.15.0",
        "helmet": "^7.1.0",
        "isomorphic-dompurify": "^2.34.0",
        "joi": "^17.11.0",
        "jsdom": "^27.3.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "nodemailer": "^6.9.7",
        "qrcode": "^1.5.3",
        "rate-limit-redis": "^4.3.1",
        "redis": "^4.6.10",
        "typescript": "^5.3.2",
        "uuid": "^9.0.1",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@types/crypto-js": "^4.2.1",
        "@types/dompurify": "^3.2.0",
        "@types/jest": "^29.5.8",
        "@types/jsdom": "^27.0.0",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/supertest": "^2.0.16",
        "@typescript-eslint/eslint-plugin": "^6.13.1",
        "@typescript-eslint/parser": "^6.13.1",
        "eslint": "^8.54.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "jest": "^29.7.0",
        "mongodb-memory-server": "^9.1.3",
        "pm2": "^5.3.0",
        "prettier": "^3.1.0",
        "redis-memory-server": "^0.10.0",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Emmanuel-Odero/1815.git"
    },
    "homepage": "https://1815.dev",
    "bugs": {
        "url": "https://github.com/Emmanuel-Odero/1815/issues"
    }
}