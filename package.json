{
    "name": "1815-api",
    "version": "1.0.0",
    "description": "1815 API - Cardano address shortener and blockchain explorer service",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "format": "prettier --write src/**/*.ts",
        "format:check": "prettier --check src/**/*.ts",
        "docker:build": "docker build -t 1815-api .",
        "docker:dev": "docker-compose up -d",
        "docker:down": "docker-compose down"
    },
    "keywords": [
        "cardano",
        "blockchain",
        "api",
        "shortener",
        "explorer",
        "1815"
    ],
    "author": "Emmanuel Odero <emmanuel@techmates.team>",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "mongoose": "^8.0.3",
        "redis": "^4.6.10",
        "bull": "^4.12.2",
        "joi": "^17.11.0",
        "bcryptjs": "^2.4.3",
        "jsonwebtoken": "^9.0.2",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "compression": "^1.7.4",
        "winston": "^3.11.0",
        "dotenv": "^16.3.1",
        "@sendgrid/mail": "^8.1.0",
        "nodemailer": "^6.9.7",
        "qrcode": "^1.5.3",
        "aws-sdk": "^2.1498.0",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "crypto-js": "^4.2.0",
        "uuid": "^9.0.1",
        "fast-check": "^3.15.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17",
        "@types/compression": "^1.7.5",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/qrcode": "^1.5.5",
        "@types/nodemailer": "^6.4.14",
        "@types/crypto-js": "^4.2.1",
        "@types/uuid": "^9.0.7",
        "@types/jest": "^29.5.8",
        "@typescript-eslint/eslint-plugin": "^6.13.1",
        "@typescript-eslint/parser": "^6.13.1",
        "eslint": "^8.54.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "prettier": "^3.1.0",
        "typescript": "^5.3.2",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "mongodb-memory-server": "^9.1.3",
        "redis-memory-server": "^0.10.0",
        "supertest": "^6.3.3",
        "@types/supertest": "^2.0.16"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Emmanuel-Odero/1815.git"
    },
    "homepage": "https://1815.dev",
    "bugs": {
        "url": "https://github.com/Emmanuel-Odero/1815/issues"
    }
}