# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/1815_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100

# Blockfrost API
BLOCKFROST_API_KEY=dev_blockfrost_api_key_placeholder
BLOCKFROST_BASE_URL=https://cardano-mainnet.blockfrost.io/api/v0
BLOCKFROST_NETWORK=mainnet

# SendGrid Email (Production)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@1815.dev
SENDGRID_FROM_NAME=1815

# MailHog (Development Email Testing)
# Set USE_MAILHOG=true to use MailHog instead of SendGrid for development
USE_MAILHOG=true
MAILHOG_HOS

# AWS S3 (for QR code storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=1815-qr-codes

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_ALGORITHM=aes-256-gcm

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# QR Code Configuration
QR_CODE_BASE_URL=https://1815.dev/qr
QR_CODE_SIZE=200
QR_CODE_MARGIN=2

# Administrator emails for job failure alerts (comma-separated)
ADMIN_EMAILS=admin@1815.dev,ops@1815.dev