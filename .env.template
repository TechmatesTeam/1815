# ============================================================================
# 1815 Cardano Service - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control!
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment: development, staging, production
NODE_ENV=development

# Server port
PORT=3000

# Application base URL (used in emails, QR codes, etc.)
APP_BASE_URL=http://localhost:3000

# Frontend URL (used in verification emails, redirects)
FRONTEND_URL=http://localhost:5173

# ============================================================================
# DATABASE - MONGODB
# ============================================================================

# MongoDB connection string
# Format: mongodb://[username:password@]host[:port]/database[?options]
MONGODB_URI=mongodb://localhost:27017/1815_dev

# MongoDB connection pool settings
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ============================================================================
# CACHE/QUEUE - REDIS
# ============================================================================

# Redis connection URL
# Format: redis://[username:password@]host[:port][/database]
REDIS_URL=redis://localhost:6379

# Redis password (if required)
REDIS_PASSWORD=

# Redis connection retry settings
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100

# ============================================================================
# BLOCKCHAIN - BLOCKFROST API
# ============================================================================

# Blockfrost API key (REQUIRED)
# Get your free API key at: https://blockfrost.io
BLOCKFROST_API_KEY=your_blockfrost_api_key_here

# Blockfrost network: mainnet, testnet, preprod, preview
BLOCKFROST_NETWORK=mainnet

# Blockfrost base URL (optional, uses default if not set)
# BLOCKFROST_BASE_URL=https://cardano-mainnet.blockfrost.io/api/v0

# ============================================================================
# EMAIL - SENDGRID (Production)
# ============================================================================

# SendGrid API key (for production email sending)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Email sender address
SENDGRID_FROM_EMAIL=noreply@1815.dev

# Email sender name
SENDGRID_FROM_NAME=1815

# ============================================================================
# EMAIL - MAILHOG (Development)
# ============================================================================

# Use MailHog for development email testing
# Set to 'true' to capture emails locally instead of sending via SendGrid
USE_MAILHOG=true

# MailHog SMTP settings (when USE_MAILHOG=true)
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# MailHog web UI: http://localhost:8025

# ============================================================================
# AUTHENTICATION - JWT
# ============================================================================

# JWT secret key (REQUIRED for production)
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# JWT token expiration time
# Examples: 7d (7 days), 24h (24 hours), 60m (60 minutes)
JWT_EXPIRES_IN=7d

# ============================================================================
# ENCRYPTION
# ============================================================================

# Encryption key for sensitive data (must be 32 characters)
# Generate: openssl rand -hex 16
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Encryption algorithm
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================================================
# STORAGE - AWS S3 (Optional)
# ============================================================================

# AWS credentials (for QR code storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# AWS region
AWS_REGION=us-east-1

# S3 bucket name for QR codes
AWS_S3_BUCKET=1815-qr-codes

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX=100

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Allowed origins (comma-separated)
# Examples:
#   Single: http://localhost:3000
#   Multiple: http://localhost:3000,http://localhost:5173
#   All: * (not recommended for production)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ============================================================================
# QR CODE CONFIGURATION
# ============================================================================

# Base URL for QR codes
QR_CODE_BASE_URL=https://1815.dev/qr

# QR code image size in pixels
QR_CODE_SIZE=200

# QR code margin in modules
QR_CODE_MARGIN=2

# ============================================================================
# BACKGROUND JOBS
# ============================================================================

# Enable/disable background jobs
JOBS_ENABLED=true

# Enable cache warming job
CACHE_WARMING_ENABLED=true

# Enable alias expiration job
ALIAS_EXPIRATION_ENABLED=true

# Enable notifications job
NOTIFICATIONS_ENABLED=true

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features
FEATURE_EXPLORER=true
FEATURE_NOTIFICATIONS=true
FEATURE_PAYMENTS=true
FEATURE_QR_CODES=true

# ============================================================================
# MONITORING & ALERTS
# ============================================================================

# Administrator emails for job failure alerts (comma-separated)
ADMIN_EMAILS=admin@1815.dev,ops@1815.dev

# ============================================================================
# LOGGING
# ============================================================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log format: json, simple
LOG_FORMAT=json

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Enable debug mode (verbose logging)
DEBUG=false

# Disable SSL verification (development only, never use in production!)
NODE_TLS_REJECT_UNAUTHORIZED=1

# ============================================================================
# NOTES
# ============================================================================
#
# REQUIRED VARIABLES (minimum to run):
#   - MONGODB_URI
#   - BLOCKFROST_API_KEY
#   - JWT_SECRET (for production)
#
# OPTIONAL BUT RECOMMENDED:
#   - REDIS_URL (for caching and rate limiting)
#   - SENDGRID_API_KEY (for email notifications)
#   - AWS credentials (for QR code storage)
#
# DEVELOPMENT:
#   - Set USE_MAILHOG=true to test emails locally
#   - Use testnet for BLOCKFROST_NETWORK
#   - Keep DEBUG=false unless troubleshooting
#
# PRODUCTION:
#   - Set NODE_ENV=production
#   - Use strong JWT_SECRET and ENCRYPTION_KEY
#   - Set appropriate CORS_ORIGIN
#   - Enable all security features
#   - Use mainnet for BLOCKFROST_NETWORK
#   - Set USE_MAILHOG=false
#
# SECURITY:
#   - Never commit .env files
#   - Rotate secrets regularly
#   - Use environment-specific values
#   - Restrict access to production secrets
#
# ============================================================================
