# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/1815_prod
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# External API Keys
BLOCKFROST_API_KEY=
BLOCKFROST_PROJECT_ID=

# Email Configuration
SENDGRID_API_KEY=
FROM_EMAIL=noreply@1815.dev
SUPPORT_EMAIL=support@1815.dev

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=1815-qr-codes-prod

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
CORS_ORIGIN=https://1815.dev,https://www.1815.dev
HELMET_CSP_DIRECTIVES=default-src 'self'

# Performance
CACHE_TTL=3600
COMPRESSION_LEVEL=6

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Background Jobs
JOB_CONCURRENCY=5
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000

# Health Check
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000